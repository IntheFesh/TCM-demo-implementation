# ---------- 模型后端 ----------
# api（默认，OpenAI 兼容云端 API）/ local（本地 vLLM server）/ local_inproc（进程内 vLLM）/ replay（录制回放）
LLM_MODE=api
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# 换模型即换实验条件：eval/RESULTS.md 中已有的数字不能与新模型的结果直接比较。

# ---------- 可选项（不写即取默认值）----------
# LLM_TIMEOUT_SECONDS=600       单次调用的读超时秒数。不设时按后端取默认值：云端 API 与本地 server
#                               读 600 秒 / 墙钟 900 秒，进程内 vLLM 1800 秒。另有一层整次调用的
#                               墙钟兜底：读超时只约束单次 socket 读取。
# LLM_MAX_TOKENS=8192           单次输出上限。不设时按调用档位取：关闭思考 8192、开启思考 32768、
#                               reasoning_effort=max 时 65536（推理 token 计入上限）。
# PRODUCT_MODE=1                1 = 产品界面（医师/学生/患者）；0 = 研究界面（加研究者角色、检索模式选择、用量看板）
# S3_MODE=derived               derived（医理规则演绎，默认）/ structured（融合多位医家）/ legacy（三位医家并列）
# RETRIEVER_MODE=full_context   full_context（默认）/ hybrid / dense / bm25 / graph；HTTP 请求可逐请求用 retriever_mode 覆盖
# S3_THINKING=enabled           S3 是否开启思考；S1/S2/追问/ReAct 一律关闭思考
# S3_REASONING_EFFORT=          low/medium/high/max；不设时 full_context 取 medium，其他检索方式取 low
# S3_BEST_OF_N=1                S3 采样次数，按方剂评分挑最高的一次；调用数随之增加
# S1S2_MERGED=0                 1 = S1 与 S2 合成一次调用（默认关：安全检查需要在 S2 之前完成）
# USE_REACT=0                   1 = 开启 ReAct 取证（full_context 下不生效）
# FAST_MODE=0                   1 = 不追问、ReAct 步数降为 2、关闭残差检查、S3 只采样一次
# EVAL_MODE=0                   1 = 命中危重症状后不中止链路（仅用于离线评测，对外服务不要开启）
# MAX_CONCURRENT_CONSULTS=4     同时进行的问诊数上限，满了返回 503
# LLM_MAX_INFLIGHT=6            同时在途的 LLM 请求数上限（多位医家并发推理时限制对模型服务的并发）
# EMBEDDING_CACHE=1             语料向量磁盘缓存，0 = 关闭
# EMBEDDING_CACHE_DIR=data/cache
# WARMUP_TIMEOUT_SECONDS=120    压测/冒烟脚本等待服务就绪的时间预算（服务本身启动后立即监听，预热在后台进行）

# ---------- 录制回放 ----------
# 先用真实后端录制一次，之后回放不发任何网络请求、不需要 key，结果可复现：
#   python -m scripts.record_fixtures --dry-run   查看录制清单与预估调用数
#   python -m scripts.record_fixtures             录制（需要真实 key）
#   python -m scripts.verify_replay               退出码 0 = 回放与录制一致
# 回放时 manifest.backend 为 "replay" 并带 replayed_from，界面顶部显示「回放模式」提示。
# LLM_MODE=replay
# REPLAY_FIXTURES_DIR=fixtures

# ---------- 本地模型（vLLM）----------
#   local        = 对接 vLLM 的 OpenAI 兼容 server（在线服务）
#   local_inproc = 进程内 vllm.LLM（批量评测）
# 启动 server：bash scripts/start_vllm.sh；验证：python -m scripts.verify_local_backend
# LLM_MODE=local
# LLM_MODEL_PATH=/path/to/models/Qwen2.5-1.5B-Instruct
# LLM_MODEL=tcm-local                server 的 --served-model-name（manifest 记录的是 LLM_MODEL_PATH）
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LORA_DIR=                          按医家挂 adapter：$LORA_DIR/<physician_id>/；设置后缺目录会报错
# VLLM_GUIDED_JSON_KEY=guided_json   vLLM 不认这个参数名时在这里修改
# VLLM_MAX_MODEL_LEN=8192            仅对 local_inproc 生效
# VLLM_GPU_MEMORY_UTILIZATION=0.85   仅对 local_inproc 生效

# ---------- 公开部署的用量控制 ----------
# 访问者可以自带 key（请求头 X-LLM-Key，只接受 sk- 格式）：只用于本次请求，
# 不落盘、不进日志与 manifest，也不计入站点额度。
# 不带 key 的请求使用站点共享额度，额度按 LLM 调用数计。不设下面两个变量时，默认值由
# core.usage.calls_per_consult() 按当前配置算出（每 IP 每天 5 次问诊、全站每天 200 次问诊）。
# 额度账本在进程内存里，服务重启后重置。
# QUOTA_PER_IP_DAILY_CALLS=
# QUOTA_GLOBAL_DAILY_CALLS=

# 额度账本最多记录的 IP 数，超过之后新 IP 归入共用桶。
QUOTA_MAX_TRACKED_IPS=5000

# 受信反向代理层数。默认 0 = 不读 X-Forwarded-For，只用 TCP 对端地址；
# 部署在 N 层自己的反向代理之后时设为 N，从右数第 N 跳取客户端地址。
# TRUSTED_PROXY_HOPS=1

# 紧急熔断：所有请求（包括自带 key 的）强制走录制回放。
# FORCE_REPLAY=1

# ---------- HIS 集成接口 ----------
# 逗号分隔的 API Key；不设置时集成接口默认拒绝。可选 IP 白名单（逗号分隔）。
# HIS_API_KEYS=
# HIS_IP_ALLOWLIST=
