LLM_MODE=api
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# ⚠ deepseek-chat 已于 2026-09 下线：用它发请求得到 HTTP 200 + 空响应体（不是 404）。
#   段 0（bash scripts/run_onsite.sh --only 0）会查 $LLM_BASE_URL/models 提前挡掉。
#   换模型 = 仓库里所有既有数字都不可直接比较，见 eval/RESULTS.md 的 ⚠ 第 4 条。

# 可选项（默认值见 README「.env 关键字段」表；不写就是默认）
# LLM_TIMEOUT_SECONDS=120      单次调用的读超时秒数（旧名 LLM_TIMEOUT 仍然认）。
#                             不设时按后端取默认值：云端 120、本地 server 600、进程内 1800。
#                             另有一层墙钟兜底（读超时管的是单次 socket 读，挡不住对方细水长流地吐字节）
# LLM_MAX_TOKENS=16384         单次输出上限。不设时按模型分两档（core/llm.py
#                             _default_max_tokens）：非推理模型 8192、推理模型 16384。
#                             推理模型的 max_tokens 同时盖住不可见的 reasoning tokens，
#                             8192 下 deepseek-v4-pro 的 S3 输出实测在 2081 字符处被砍断
# USE_REACT=0                   1 = 打开 ReAct 取证
# FAST_MODE=0                   1 = 追问 0 轮 + ReAct 2 步 + 关残差
# EVAL_MODE=0                   1 = 安全否决不中止（只给评测用，对外演示的机器不要开）
# MAX_CONCURRENT_CONSULTS=4     同时进行的问诊数上限，满了 503
# LLM_MAX_INFLIGHT=6            同时在途的 LLM 请求数上限。跟上面那个是两件事：
#                             4 个问诊槽 × 3 位医家 = 12 路同时打 API，会撞 429
# S3_THINKING=enabled           S3 开不开思考（S1/S2/追问/ReAct 一律关）。
#                             改成 disabled 会更快，但跑出来的数字跟默认配置不可比
# EMBEDDING_CACHE=1             语料向量磁盘缓存，0 = 关掉
# EMBEDDING_CACHE_DIR=data/cache  换个地方放缓存
# WARMUP_TIMEOUT_SECONDS=120    启动预热最多等多久，超过先开始服务
# CLAUDE_CLI_MODEL=claude-sonnet-5
# CLAUDE_CLI_TIMEOUT=180

# 录制回放（竞赛演示 / 网站上线用）。零成本、零延迟、断网可用、每次结果完全一致。
# 先用真实后端录一次，之后就只回放，不发任何网络请求、不需要 key。
#   python -m scripts.record_fixtures --dry-run   先看清单和预估调用数
#   python -m scripts.record_fixtures             真录（需要真实 key）
#   python -m scripts.verify_replay               退出码 0 = 回放跟录制逐字节一致
# 回放时 manifest 的 backend 是 "replay"、带 replayed_from，前端会显示一行
# 「演示模式：结果来自 X 录制的真实推理（模型 Y），非实时调用」——这行不可省略。
# LLM_MODE=replay
# REPLAY_FIXTURES_DIR=fixtures   # 默认就是仓库根的 fixtures/

# 本地模型（vLLM）。两种模式都可用，区别与验证方式见 README「本地模型部署」一节：
#   local        = 对着 vLLM 起的 OpenAI 兼容 server（在线服务/演示）
#   local_inproc = 进程内 vllm.LLM（批量评测，省掉 HTTP 往返）
# 起 server：bash scripts/start_vllm.sh
# 验证接上了：python -m scripts.verify_local_backend   （退出码 0 = 通过）
# LLM_MODE=local
# LLM_MODEL_PATH=/root/autodl-tmp/models/Qwen2.5-1.5B-Instruct
# LLM_MODEL=tcm-local           server 的 --served-model-name（manifest 记的是 MODEL_PATH）
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LORA_DIR=                     按医家挂 adapter：$LORA_DIR/<physician_id>/
#                               不设 = 跑基座模型；设了但某位医家目录不存在 = 报错，不静默退化
# VLLM_GUIDED_JSON_KEY=guided_json   vLLM 版本不认这个键时改这里，不用改代码
# VLLM_MAX_MODEL_LEN=8192            只对 local_inproc 生效
# VLLM_GPU_MEMORY_UTILIZATION=0.85   只对 local_inproc 生效

# ---------- D1：公开部署的三层用量控制 ----------
# 访问者可以在页面上填自己的 API key（BYOK）：走 X-LLM-Key 请求头，只存在浏览器
# 的 sessionStorage 里，服务端不落盘、不进日志、不进 manifest，也不计站点额度。
#
# 不填 key 的用站点共享额度。**额度单位是 llm_calls 不是请求数**：开不开 ReAct，
# 一次问诊的调用数差三倍以上，按请求数计等于让开着 ReAct 的人花别人三倍的钱记
# 同一笔账。下面两个默认值约等于"每 IP 每天 5 次、全站每天 200 次"不开 ReAct 的问诊。
# 额度账本在进程内存里，**服务重启会重置**（看板上的 since 字段如实标明起算时间）。
QUOTA_PER_IP_DAILY_CALLS=25
QUOTA_GLOBAL_DAILY_CALLS=1000

# BYOK 的 key 在保存前会走一次 DeepSeek 官方的「查询余额」接口验证
# （GET {LLM_BASE_URL}/user/balance，零 token 消耗）。LLM_BASE_URL 带 /v1 时会自动
# 去掉——余额接口挂在根路径上，不在 OpenAI 兼容路径下。
#
# 受信反代跳数。**默认 0 = 完全不读 X-Forwarded-For**，只用 TCP 对端地址。
# 最左那一跳是客户端自己能写的，拿它当限流 key 等于把 key 交给攻击者
# （轮换伪造值就能让每条请求都算成新 IP）。部署在 N 层受信反代后面时才设成 N，
# 代码从右数第 N 跳取。见 MDN 的 X-Forwarded-For 安全小节。
# TRUSTED_PROXY_HOPS=1

# 不同 IP 计数桶的上限，防轮换 IP 把账本撑爆；超过之后新 IP 归入共用桶。
QUOTA_MAX_TRACKED_IPS=5000

# 手动熔断。出事时（key 泄漏、被刷、账单异常）不改代码、不重新构建就能把所有
# 真实调用停掉，全部降级到录制回放。压过一切，包括自带 key 的请求。
# FORCE_REPLAY=1
