{"code":"TB-257","name":"溢饮证","is_category":false,"parent":null,"definition":"肺脾失调，寒水内留，泛溢肢体。","location":["脾","肺"],"nature":["寒"],"cardinal_symptoms":["身体沉重而疼痛","甚则肢体浮肿","伴恶寒无汗","或有咳喘","痰多白沫","胸闷","干呕","口不渴","苔白","脉弦紧。"],"secondary_symptoms":[],"tongue_pulse":null,"disease":"痰饮","source":"textbook","icd11_code":null}
