{"code":"TB-192","name":"热瘴证","is_category":false,"parent":null,"definition":"瘴毒内盛，热陷心包。","location":["心"],"nature":["热"],"cardinal_symptoms":["热甚寒微","或壮热不寒","头痛","肢体烦疼","面红目赤","胸闷呕吐","烦渴饮冷","大便秘结","小便热赤","甚至神昏语"],"secondary_symptoms":[],"tongue_pulse":"舌质红绛，苔黄腻或垢黑，脉洪数或弦数","disease":"疟疾","source":"textbook","icd11_code":null}
