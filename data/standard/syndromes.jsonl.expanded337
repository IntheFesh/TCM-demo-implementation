{"code": "SP-01", "name": "肝胃不和证", "is_category": false, "parent": null, "definition": "肝气犯胃，胃失和降所致，以胃脘胀满或疼痛、两胁胀满，情志不畅时发作或加重为特征的证候。", "location": ["肝", "胃"], "nature": ["气滞"], "cardinal_symptoms": ["胃脘胀满或疼痛", "两胁胀满"], "secondary_symptoms": ["每因情志不畅而发作或加重", "心烦", "嗳气频作", "善叹息"], "tongue_pulse": "舌淡红，苔薄白；脉弦", "source": "official_consensus", "icd11_code": null}
{"code": "SP-02", "name": "脾虚气滞证", "is_category": false, "parent": null, "definition": "脾气亏虚、运化无力兼气机郁滞，以胃脘痞闷或胀痛、纳呆为特征的证候。", "location": ["脾", "胃"], "nature": ["气虚", "气滞"], "cardinal_symptoms": ["胃脘痞闷或胀痛", "纳呆"], "secondary_symptoms": ["嗳气", "疲乏", "便溏"], "tongue_pulse": "舌淡，苔薄白；脉细弦", "source": "official_consensus", "icd11_code": null}
{"code": "SP-03", "name": "脾胃湿热证", "is_category": false, "parent": null, "definition": "湿热蕴结脾胃，纳运失常，以脘腹痞满或疼痛、口干或口苦为特征的证候。", "location": ["脾", "胃"], "nature": ["湿", "热"], "cardinal_symptoms": ["脘腹痞满或疼痛", "口干或口苦"], "secondary_symptoms": ["口干不欲饮", "纳呆", "恶心或呕吐", "小便短黄"], "tongue_pulse": "舌红，苔黄厚腻；脉滑", "source": "official_consensus", "icd11_code": null}
{"code": "SP-04", "name": "脾胃虚寒证", "is_category": false, "parent": null, "definition": "脾胃阳气亏虚，失于温煦，以胃脘隐痛或痞满、喜温喜按为特征的证候。", "location": ["脾", "胃"], "nature": ["阳虚", "寒"], "cardinal_symptoms": ["胃脘隐痛或痞满", "喜温喜按"], "secondary_symptoms": ["泛吐清水", "食少或纳呆", "疲乏", "手足不温", "便溏"], "tongue_pulse": "舌淡，苔白；脉细弱", "source": "official_consensus", "icd11_code": null}
{"code": "SP-05", "name": "寒热错杂证", "is_category": false, "parent": null, "definition": "寒邪与热邪互结中焦，升降失司，以胃脘痞满或疼痛（遇冷加重）、口干或口苦并见为特征的证候。", "location": ["脾", "胃"], "nature": ["寒", "热"], "cardinal_symptoms": ["胃脘痞满或疼痛，遇冷加重", "口干或口苦"], "secondary_symptoms": ["纳呆", "嘈杂", "恶心或呕吐", "肠鸣", "便溏"], "tongue_pulse": "舌淡，苔黄；脉弦细滑", "source": "official_consensus", "icd11_code": null}
{"code": "B04.06.02.03.01.03", "name": "肝气乘脾证", "is_category": false, "parent": null, "definition": "肝气横逆乘脾，脾运受制，以胁肋胀痛或窜痛、急躁易怒、脘腹痞满为特征的证候，古称木旺乘土证。", "location": ["肝", "脾"], "nature": ["气滞"], "cardinal_symptoms": ["胁肋胀痛或窜痛", "急躁易怒", "脘腹痞满"], "secondary_symptoms": ["纳差", "泄利下重", "腹中痛"], "tongue_pulse": "舌质淡红，舌苔薄白或白；脉弦", "source": "journal", "icd11_code": null}
{"code": "B04.06.02.03.01.02", "name": "肝郁脾虚证", "is_category": false, "parent": null, "definition": "肝失疏泄、脾失健运并见，以情志抑郁或善太息、脘腹胁肋闷胀（食后加重）为特征的证候，古称木不疏土证。", "location": ["肝", "脾"], "nature": ["气滞", "气虚"], "cardinal_symptoms": ["情志抑郁或善太息", "脘腹胁肋闷胀，食后加重"], "secondary_symptoms": ["纳差", "肠鸣", "矢气", "溏结不调"], "tongue_pulse": "舌质淡红，舌苔薄白；脉弦或细", "source": "journal", "icd11_code": null}
{"code": "SP-06", "name": "脾虚肝乘证", "is_category": false, "parent": null, "definition": "脾气先虚、肝气乘之，以脘腹痞满、腹痛即泻泻后痛减为特征的证候，古称土虚木乘证。", "location": ["脾", "肝"], "nature": ["气虚"], "cardinal_symptoms": ["脘腹痞满", "腹痛即泻，泻后痛减"], "secondary_symptoms": ["倦怠乏力", "肠鸣", "急躁易怒", "大便溏薄"], "tongue_pulse": "舌淡胖，边有齿痕，舌苔薄白或白；脉弦缓", "source": "journal", "icd11_code": null}
{"code": "SP-07", "name": "脾虚湿阻证", "is_category": false, "parent": null, "definition": "脾胃阳虚，湿邪内阻，津液输布障碍，以面色黄而虚浮、脘痞、腹胀、大便稀溏为特征的证候。", "location": ["脾"], "nature": ["气虚", "湿"], "cardinal_symptoms": ["面色黄而虚浮", "脘痞", "腹胀", "大便稀溏"], "secondary_symptoms": ["食欲减退甚则饭后思睡", "渴不多饮", "口中黏腻", "身体困重"], "tongue_pulse": "脉濡（舌象未见于本次取证片段，待核）", "source": "group_standard", "icd11_code": null}
{"code": "B04.03.01.03.01", "name": "脾气虚证", "is_category": false, "parent": null, "definition": "脾气亏虚，运化及升清功能减退，以倦怠懒言、大便溏稀、食欲减退为特征的证候。", "location": ["脾"], "nature": ["气虚"], "cardinal_symptoms": ["倦怠懒言", "大便溏稀", "食欲减退"], "secondary_symptoms": ["食后腹胀", "脘腹隐痛，遇劳而发", "口淡无味", "面色萎黄", "排便无力"], "tongue_pulse": "舌质淡或伴齿痕、苔薄白；脉弱无力", "source": "official_consensus", "icd11_code": "SF70"}
{"code": "SP-08", "name": "脾不统血证", "is_category": false, "parent": null, "definition": "脾气亏虚，统摄血液功能失职，血离经妄行，以便血、尿血、肌衄、齿衄为特征的证候，多因久病脾虚或劳倦伤脾引起。", "location": ["脾"], "nature": ["气虚"], "cardinal_symptoms": ["便血", "尿血", "肌衄", "齿衄"], "secondary_symptoms": ["眩晕", "神疲乏力", "少气懒言", "食少便溏", "面色无华"], "tongue_pulse": "舌淡苔白，脉细弱", "source": "secondary_verified", "icd11_code": null}
{"code": "SP-09", "name": "胃阴虚证", "is_category": false, "parent": null, "definition": "胃阴亏耗，胃失濡润、和降失常，以胃脘隐痛、嘈杂善饥、口干唇燥为特征的证候，空腹时加重。", "location": ["胃"], "nature": ["阴虚"], "cardinal_symptoms": ["胃脘隐痛", "嘈杂善饥", "口干唇燥"], "secondary_symptoms": ["空腹时加重", "饥不欲食", "大便干结", "手足心热"], "tongue_pulse": "舌红少苔，中有裂纹；脉细数", "source": "secondary_verified", "icd11_code": null}
{"code": "SP-10", "name": "痰饮内停证", "is_category": false, "parent": null, "definition": "《金匮要略》痰饮理论分痰饮、悬饮、支饮、溢饮四类，此指饮邪停聚中焦胃肠，以咳喘痰稀、胸胁胀满为特征的证候，与肺脾肾三焦气化失调相关。", "location": ["脾", "胃"], "nature": ["痰", "饮"], "cardinal_symptoms": ["咳喘痰稀", "胸胁胀满或胀痛"], "secondary_symptoms": ["水肿", "眩晕心悸"], "tongue_pulse": "舌苔白腻，脉弦滑", "source": "secondary_verified", "icd11_code": null}
{"code":"SP-11","name":"胃热壅盛证","is_category":false,"parent":null,"definition":"热邪壅盛于胃，迫血妄行，以脘腹胀闷、吐血色红或紫黯、常夹食物残渣为特征的证候，属血证-吐血范畴，治宜苦寒泻火（泻心汤，《血证论》称「方名泻心，实则泻胃」）。","location":["胃"],"nature":["热"],"cardinal_symptoms":["脘腹胀闷，甚则作痛","吐血色红或紫黯，常夹食物残渣"],"secondary_symptoms":["口臭","便秘","大便色黑"],"tongue_pulse":"舌质红，苔黄腻；脉滑数","source":"secondary_verified","icd11_code":null}
{"code":"SP-12","name":"痰气交阻证","is_category":false,"parent":null,"definition":"饮食不节或七情内伤致气滞痰阻，多见于噎膈病，以吞咽梗阻、胸膈痞满、嗳气呃逆为特征的证候，情志抑郁时加重、舒畅时减轻。","location":["胃"],"nature":["气滞","痰"],"cardinal_symptoms":["吞咽梗阻","胸膈满闷，甚则疼痛"],"secondary_symptoms":["情志抑郁时加重、舒畅时减轻","嗳气呃逆","呕吐痰涎","口干咽燥","大便艰涩"],"tongue_pulse":"舌质红，苔薄腻；脉弦滑","source":"manual","icd11_code":null}
{"code":"SP-13","name":"气滞血阻证","is_category":false,"parent":null,"definition":"属积证初期，气滞渐及血分，以腹部积块质软不坚、固定不移、胀痛不适为特征的证候，病位在肝脾，与瘀血内结证为病程渐进关系（气滞血阻日久可转为瘀血内结）。","location":["肝","脾"],"nature":["气滞","血瘀"],"cardinal_symptoms":["腹部积块质软不坚，固定不移","胀痛不适"],"secondary_symptoms":[],"tongue_pulse":"舌苔薄，脉弦","source":"secondary_verified","icd11_code":null}
{"code":"SP-14","name":"瘀血内结证","is_category":false,"parent":null,"definition":"属积证中期，瘀血内结日久，以腹部积块明显、质地较硬、固定不移、隐痛或刺痛为特征的证候，常伴形体消瘦、面色晦暗，为气滞血阻证进一步发展所致。","location":["肝","脾"],"nature":["血瘀"],"cardinal_symptoms":["腹部积块明显，质地较硬，固定不移","隐痛或刺痛"],"secondary_symptoms":["形体消瘦","纳谷减少","面色晦暗黧黑","面颈胸臂或有血痣赤缕"],"tongue_pulse":"舌质紫或有瘀斑瘀点；脉细涩","source":"secondary_verified","icd11_code":null}
{"code":"TB-001","name":"风寒束表证","is_category":false,"parent":null,"definition":"风寒外束，卫阳被郁，理内闭，肺气不宣。","location":["肺"],"nature":["寒"],"cardinal_symptoms":["恶寒重","发热轻","无汗","头痛","肢体酸楚","甚则疼痛","鼻塞声重","喷嚏","时流清 涕","咽痒","咳嗽","痰白稀薄"],"secondary_symptoms":[],"tongue_pulse":"舌苔薄白，脉浮或浮紧","disease":"感冒","source":"textbook","icd11_code":null}
{"code":"TB-002","name":"风热犯表证","is_category":false,"parent":null,"definition":"风热犯表，热郁肌，卫表失和，肺失清肃。","location":["肺"],"nature":["热"],"cardinal_symptoms":["身热较著","微恶风","汗泄不畅","咽干甚则咽痛","鼻塞","流黄稠涕","头胀痛","咳嗽","痰黏或黄","口干欲饮","舌尖红"],"secondary_symptoms":[],"tongue_pulse":"舌苔薄白干或薄黄，脉浮数","disease":"感冒","source":"textbook","icd11_code":null}
{"code":"TB-003","name":"暑湿伤表证","is_category":false,"parent":null,"definition":"暑湿伤表，表卫不和，肺气不清。","location":["肺"],"nature":["湿"],"cardinal_symptoms":["发热","微恶风","身热不扬","汗出不畅","肢体困重或酸痛","头重如裹","胸闷脘痞","纳呆","鼻塞","流浊涕","心烦口渴","大便或唐","小便短赤"],"secondary_symptoms":[],"tongue_pulse":"舌苔白腻或黄腻，脉濡数","disease":"感冒","source":"textbook","icd11_code":null}
{"code":"TB-004","name":"气虚感冒证","is_category":false,"parent":null,"definition":"素体气虚，卫外不固，风邪乘袭。","location":[],"nature":["气虚"],"cardinal_symptoms":["恶寒较甚","或并发热","鼻塞","流涕","气短","乏力","自汗","咳嗽","痰白","咳痰无 力","平素神疲体弱","或易感冒"],"secondary_symptoms":[],"tongue_pulse":"舌淡苔薄白，脉浮无力","disease":"感冒","source":"textbook","icd11_code":null}
{"code":"TB-005","name":"阴虚感冒证","is_category":false,"parent":null,"definition":"阴亏津少，外受风热，表卫失和。","location":[],"nature":["热"],"cardinal_symptoms":["身热","微恶风寒","无汗或微汗或盗汗","干咳少痰","头昏","心烦","口干","甚则口 渴"],"secondary_symptoms":[],"tongue_pulse":"舌红少苔，脉细数","disease":"感冒","source":"textbook","icd11_code":null}
{"code":"TB-006","name":"阳虚感冒证","is_category":false,"parent":null,"definition":"素体阳虚，外感风寒，邪在肌表。","location":[],"nature":["阳虚","寒"],"cardinal_symptoms":["恶寒重","发热轻","头痛身痛","无汗","面色白","语声低微","四肢不温"],"secondary_symptoms":[],"tongue_pulse":"舌质淡胖，苔白，脉沉细无力","disease":"感冒","source":"textbook","icd11_code":null}
{"code":"TB-007","name":"风寒袭肺证","is_category":false,"parent":null,"definition":"风寒袭肺，肺气失宣。","location":["肺"],"nature":["寒"],"cardinal_symptoms":["咳嗽声重","气急","咽痒","咳白稀痰","常伴有鼻塞","流清涕","头痛","肢体酸痛","恶寒发热","无汗"],"secondary_symptoms":[],"tongue_pulse":"舌苔薄白，脉浮或浮紧","disease":"咳嗽","source":"textbook","icd11_code":null}
{"code":"TB-008","name":"风热犯肺证","is_category":false,"parent":null,"definition":"风热犯肺，肺失清肃。","location":["肺"],"nature":["热"],"cardinal_symptoms":["咳嗽频剧","气粗或咳声嘶哑","喉燥咽痛","咳痰不爽","痰黏稠或色黄","常伴有鼻流黄涕","口渴","头痛","恶风","身热"],"secondary_symptoms":[],"tongue_pulse":"舌红，苔薄黄，脉浮数或浮滑","disease":"咳嗽","source":"textbook","icd11_code":null}
{"code":"TB-009","name":"风燥伤肺证","is_category":false,"parent":null,"definition":"风燥伤肺，肺失清润。","location":["肺"],"nature":[],"cardinal_symptoms":["干咳无痰","或痰少而黏","不易咳出","或痰中带有血丝","咽喉干痛","口鼻干燥","初起或伴有少许恶寒","身热头痛"],"secondary_symptoms":[],"tongue_pulse":"舌尖红，苔薄白或薄黄而干，脉浮数或小数","disease":"咳嗽","source":"textbook","icd11_code":null}
{"code":"TB-010","name":"痰湿蕴肺证","is_category":false,"parent":null,"definition":"脾湿生痰，上渍于肺，雍遏肺气。","location":["脾","肺"],"nature":["痰","湿"],"cardinal_symptoms":["咳嗽反复发作","咳声重浊","因痰而嗽","痰出则咳缓","痰多色白","黏腻或稠厚成块","每于晨起或食后咳甚痰多","胸闷脘痞","纳差乏力","大便时唐"],"secondary_symptoms":[],"tongue_pulse":"舌苔白腻，脉濡滑","disease":"咳嗽","source":"textbook","icd11_code":null}
{"code":"TB-011","name":"痰热郁肺证","is_category":false,"parent":null,"definition":"痰热壅肺，肺失肃降。","location":["肺"],"nature":["痰","热"],"cardinal_symptoms":["咳嗽气粗","喉中可闻及痰声","痰多黄稠或黏厚","咳吐不爽","或有热腥味","或夹有血丝","胸胁胀满","咳时引痛","常伴有面赤","或有身热","口干欲饮"],"secondary_symptoms":[],"tongue_pulse":"舌红，苔薄黄腻，脉滑数","disease":"咳嗽","source":"textbook","icd11_code":null}
{"code":"TB-012","name":"肝火犯肺证","is_category":false,"parent":null,"definition":"肝郁化火，上逆侮肺。","location":["肝","肺"],"nature":[],"cardinal_symptoms":["上气咳逆阵作","咳时面红目赤","引胸胁作痛","咽干口苦","常感痰滞咽喉而咳之难 出","量少质黏","或痰如絮条","症状可随情绪波动而增减"],"secondary_symptoms":[],"tongue_pulse":"舌红，苔薄黄少津，脉弦数","disease":"咳嗽","source":"textbook","icd11_code":null}
{"code":"TB-013","name":"肝火犯肺证","is_category":false,"parent":null,"definition":"肺阴亏虚，虚热内灼，肺失润降。","location":["肺"],"nature":["热"],"cardinal_symptoms":["干咳","咳声短促","痰少质黏色白","或痰中带血丝","或声音逐渐嘶哑","口干咽燥","午后潮热","颧红盗汗","常伴有日渐消瘦","神疲乏力"],"secondary_symptoms":[],"tongue_pulse":"舌红少苔，脉细数","disease":"咳嗽","source":"textbook","icd11_code":null}
{"code":"TB-014","name":"寒哮证","is_category":false,"parent":null,"definition":"寒痰伏肺，遇感触发，痰升气阻，肺失宣畅。","location":["肺"],"nature":["痰","寒"],"cardinal_symptoms":["呼吸急促","喉中哮鸣有声","胸膈满闷如塞","咳不甚","痰稀薄色白","咳吐不爽","面 色晦滞带青","口不渴或渴喜热饮","天冷或受寒易发","形寒畏冷。初起多兼恶寒","发热","头痛等表 证。"],"secondary_symptoms":[],"tongue_pulse":"舌苔白滑，脉弦紧或浮紧","disease":"哮病","source":"textbook","icd11_code":null}
{"code":"TB-015","name":"热哮证","is_category":false,"parent":null,"definition":"痰热蕴肺，壅阻气道，肺失清肃。","location":["肺"],"nature":["痰","热"],"cardinal_symptoms":["气粗息涌","咳呛阵作","喉中哮鸣","胸高胁胀","烦闷不安","汗出","口渴喜饮","面赤口苦","咳痰色黄或色白","黏浊稠厚","咳吐不利","不恶寒"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄腻，脉滑数或弦滑","disease":"哮病","source":"textbook","icd11_code":null}
{"code":"TB-016","name":"寒包热哮证","is_category":false,"parent":null,"definition":"痰热壅肺，复感风寒，客寒包火，肺失宣降。","location":["肺"],"nature":["痰","热","寒"],"cardinal_symptoms":["喉中鸣息有声","胸膈烦闷","呼吸急促","喘咳气逆","咳痰不爽","痰黏色黄","或黄白相兼","烦躁","发热","恶寒","无汗","身痛","口干欲饮","大便偏干","舌苔白腻罩黄"],"secondary_symptoms":[],"tongue_pulse":"舌尖边红，脉弦紧","disease":"哮病","source":"textbook","icd11_code":null}
{"code":"TB-017","name":"风痰哮证","is_category":false,"parent":null,"definition":"痰浊伏肺，风邪引触，肺气郁闭，升降失可。","location":["肺"],"nature":["痰"],"cardinal_symptoms":["喉中痰涎壅盛","声如拽锯","或鸣声如吹哨笛","喘急胸满","但坐不得卧","咳痰黏腻难出","或为白色泡沫痰液","无明显寒热倾向","面色青暗","起病多急","常忽来去","发前自觉鼻","咽","眼","耳发痒","喷嚏","鼻塞","流涕","胸部塞","随之迅即发作"],"secondary_symptoms":[],"tongue_pulse":"舌苔厚浊，脉滑实","disease":"哮病","source":"textbook","icd11_code":null}
{"code":"TB-018","name":"虚哮证","is_category":false,"parent":null,"definition":"哮病久发，痰气阻，肺肾两虚，摄纳失常。","location":["肾","肺"],"nature":["痰"],"cardinal_symptoms":["喉中哮鸣如鼾","声低","气短息促","动则喘甚","发作频繁","甚则持续哮喘","口唇爪甲青紫","咳痰无力","痰涎清稀或质黏起沫","面色苍白或颧红唇紫","口不渴或咽干口渴","形寒肢冷或烦热"],"secondary_symptoms":[],"tongue_pulse":"舌质淡或偏红，或紫暗，脉沉细或细数","disease":"哮病","source":"textbook","icd11_code":null}
{"code":"TB-019","name":"哮喘脱证","is_category":false,"parent":null,"definition":"痰浊壅盛，上蒙清窍，肺肾两亏，气阴耗伤，心肾阳衰。","location":["肾","肺","心"],"nature":["痰"],"cardinal_symptoms":["哮病反复久发","喘息鼻扇","张口抬肩","气短息促","烦躁","神志昏蒙","面青","四肢厥冷","汗出如油"],"secondary_symptoms":[],"tongue_pulse":"舌质青暗，苔腻或滑，脉细数不清，或浮大无根","disease":"哮病","source":"textbook","icd11_code":null}
{"code":"TB-020","name":"哮喘脱证","is_category":false,"parent":null,"definition":"肺卫不宣，肌表不固。","location":["肺"],"nature":[],"cardinal_symptoms":["喘促气短","语声低微","面色白","自汗畏风","咳痰清稀色白","多因气候变化而诱发","发前喷嚏频作","鼻塞流清涕"],"secondary_symptoms":[],"tongue_pulse":"舌淡苔白，脉细弱或虚大","disease":"哮病","source":"textbook","icd11_code":null}
{"code":"TB-021","name":"脾虚证","is_category":false,"parent":null,"definition":"脾失健运，痰饮蕴肺，肺气上逆。","location":["脾","肺"],"nature":["痰"],"cardinal_symptoms":["倦怠无力","食少便","面色萎黄无华","痰多而黏","咳吐不爽","胸脘满闷","恶心纳呆","或食油腻易腹泻","每因饮食不当而诱发"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，苔白滑或腻，脉细弱","disease":"哮病","source":"textbook","icd11_code":null}
{"code":"TB-022","name":"肾虚证","is_category":false,"parent":null,"definition":"肾元亏损，肾失摄纳，肺气上逆。","location":["肾","肺"],"nature":[],"cardinal_symptoms":["平素息促气短","动则为甚","呼多吸少","咳痰质黏起沫","脑转耳鸣","腰酸腿软","心慌","不耐劳累","或五心烦热","颧红","口干","或畏寒肢冷","面色苍白","舌淡苔白质胖","或"],"secondary_symptoms":[],"tongue_pulse":"舌红少苔，脉沉细或细数","disease":"哮病","source":"textbook","icd11_code":null}
{"code":"TB-023","name":"风寒雍肺证","is_category":false,"parent":null,"definition":"风寒上受，内舍于肺，邪实气壅，肺气不宣。","location":["肺"],"nature":["寒"],"cardinal_symptoms":["喘息咳逆","呼吸急促","胸部胀闷","痰多色白清稀","常伴恶寒无汗","头痛鼻塞","或有发热","口不渴"],"secondary_symptoms":[],"tongue_pulse":"舌苔薄白而滑，脉浮紧","disease":"喘证","source":"textbook","icd11_code":null}
{"code":"TB-024","name":"表寒肺热证","is_category":false,"parent":null,"definition":"寒邪束表，热郁于肺，肺气上逆。","location":["肺"],"nature":["热","寒"],"cardinal_symptoms":["喘逆上气","息粗鼻扇","胸胀或痛","咳而不爽","吐痰稠黏","伴形寒","身热","烦闷","身痛","有汗或无汗","口渴"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔薄白或黄，脉浮数或滑","disease":"喘证","source":"textbook","icd11_code":null}
{"code":"TB-025","name":"痰热郁肺证","is_category":false,"parent":null,"definition":"邪热蕴肺，蒸液成痰，痰热壅滞，肺失清肃。","location":["肺"],"nature":["痰","热"],"cardinal_symptoms":["喘咳气涌","胸部胀痛","痰多质黏色黄","或为血痰","伴胸中烦闷","身热有汗","口渴 而喜冷饮","面赤咽干","小便赤涩","大便或秘"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄腻，脉滑数","disease":"喘证","source":"textbook","icd11_code":null}
{"code":"TB-026","name":"痰浊阻肺证","is_category":false,"parent":null,"definition":"中阳不运，积湿生痰，痰浊壅肺，肺失肃降。","location":["肺"],"nature":["痰","湿"],"cardinal_symptoms":["喘咳痰鸣","胸中满闷","甚则胸盈仰息","痰多黏腻色白","咳吐不利","呕恶纳呆","口黏不渴"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，苔白腻，脉滑或濡","disease":"喘证","source":"textbook","icd11_code":null}
{"code":"TB-027","name":"肺气郁痹证","is_category":false,"parent":null,"definition":"肝气郁结，气逆犯肺，肺失宣降。","location":["肝","肺"],"nature":[],"cardinal_symptoms":["每遇情志刺激而诱发","突然呼吸短促","息粗气","胸胁闷痛","咽中如室","喉中痰鸣不著","平素多忧思抑郁","或失眠心悸","或心烦易怒","面红目赤"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔薄白或黄，脉弦","disease":"喘证","source":"textbook","icd11_code":null}
{"code":"TB-028","name":"肺气虚耗证","is_category":false,"parent":null,"definition":"肺气亏虚，气失所主，或肺阴亦虚，虚火上炎，肺失清肃。","location":["肺"],"nature":[],"cardinal_symptoms":["喘促短气","气怯声低","喉有鼾声","咳声低弱","痰吐稀薄","自汗畏风","或咳呛","痰少质黏","烦热口干","咽喉不利","面颧潮红","舌质淡红","或"],"secondary_symptoms":[],"tongue_pulse":"舌红少苔，脉软弱或细数","disease":"喘证","source":"textbook","icd11_code":null}
{"code":"TB-029","name":"肾虚不纳证","is_category":false,"parent":null,"definition":"肺病及肾，肺肾俱虚，肾不纳气。","location":["肾","肺"],"nature":[],"cardinal_symptoms":["喘促日久","动则喘甚","呼多吸少","气不得续","形瘦神惫","肿","汗出肢冷","面青唇紫","或见喘咳","面红烦躁","口咽干燥","足冷","汗出如油","舌质淡","苔白或黑润","或"],"secondary_symptoms":[],"tongue_pulse":"舌红少津，脉沉弱或细数","disease":"喘证","source":"textbook","icd11_code":null}
{"code":"TB-030","name":"正虚喘脱证","is_category":false,"parent":null,"definition":"肺气欲绝，心肾阳衰，气失所主。","location":["肾","肺","心"],"nature":[],"cardinal_symptoms":["喘逆剧甚","张口抬肩","鼻翼扇动","不能平卧","稍动则咳喘欲绝","或有痰鸣","心悸烦躁","四肢厥冷","面青唇紫","汗出如珠","脉浮大无根","或脉微欲绝。"],"secondary_symptoms":[],"tongue_pulse":null,"disease":"喘证","source":"textbook","icd11_code":null}
{"code":"TB-031","name":"初期证","is_category":false,"parent":null,"definition":"风热外袭，卫表不和，邪热壅肺，肺失清肃。","location":["肺"],"nature":["热"],"cardinal_symptoms":["恶寒发热","咳嗽","胸痛","咳时尤甚","咳吐白色黏痰","痰量由少渐多","呼吸不利","口干鼻燥"],"secondary_symptoms":[],"tongue_pulse":"舌尖红，苔薄黄或薄白少津，脉浮数而滑","disease":"肺痈","source":"textbook","icd11_code":null}
{"code":"TB-032","name":"成痈期证","is_category":false,"parent":null,"definition":"热毒蕴肺，蒸液成痰，热壅血，蕴酿成痛。","location":["肺"],"nature":["痰","热"],"cardinal_symptoms":["身热转甚","汗出身热不解","胸满作痛","转侧不利","咳吐黄稠痰","或黄绿色痰","自觉喉间有腥味","咳嗽气急","口干咽燥","烦躁不安"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄腻，脉滑数有力","disease":"肺痈","source":"textbook","icd11_code":null}
{"code":"TB-033","name":"溃脓期证","is_category":false,"parent":null,"definition":"热壅血瘀，血败肉腐，痛肿内溃，脓液外泄。","location":[],"nature":["血瘀","热"],"cardinal_symptoms":["咳吐大量脓血痰","或如米粥","腥臭异常","有时咯血","身热","面赤","烦渴喜饮","胸中烦满而痛","甚则气喘不能卧"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄腻，脉滑数或数实","disease":"肺痈","source":"textbook","icd11_code":null}
{"code":"TB-034","name":"恢复期证","is_category":false,"parent":null,"definition":"邪毒渐去，肺体损伤，阴伤气耗。","location":["肺"],"nature":[],"cardinal_symptoms":["身热渐退","咳嗽减轻","咯吐脓血渐少","臭味亦减","痰液转为清稀","精神渐振","食欲改善","或见胸胁隐痛","难以久卧","气短乏力","自汗","盗汗","低热","午后潮热","心烦","口干咽燥","面色不华","形瘦神疲"],"secondary_symptoms":[],"tongue_pulse":"舌质红或淡红，苔薄，脉细或细数无力","disease":"肺痈","source":"textbook","icd11_code":null}
{"code":"TB-035","name":"肺阴亏损证","is_category":false,"parent":null,"definition":"肺阴耗伤，津不上承，肺失滋润，肺损络伤。","location":["肺"],"nature":[],"cardinal_symptoms":["干咳","咳声短促","少痰","或痰中有时带血","如丝如点","色鲜红","兼午后手足心热","皮肤干灼","或少量盗汗","口干咽燥","胸闷隐痛"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔薄少津，脉细或兼数","disease":"肺痨","source":"textbook","icd11_code":null}
{"code":"TB-036","name":"虚火灼肺证","is_category":false,"parent":null,"definition":"肺肾阴伤，水亏火旺，虚火灼津，灼伤肺络，阴精耗损。","location":["肾","肺"],"nature":[],"cardinal_symptoms":["咳呛气急","痰少质黏","或咳痰黄稠量多","或时时咯血","血色鲜红","午后潮热","或骨蒸","盗汗量多","或五心烦热","颧红","口渴","心烦失眠","急躁易怒","胸胁痛","或男子梦遗","女子月经不调","形体日渐消瘦"],"secondary_symptoms":[],"tongue_pulse":"舌质红绛而干，苔薄黄或剥，脉细数","disease":"肺痨","source":"textbook","icd11_code":null}
{"code":"TB-037","name":"气阴耗伤证","is_category":false,"parent":null,"definition":"阴伤气耗，清肃失司，肺虚络损，气阴亏损。","location":["肺"],"nature":[],"cardinal_symptoms":["咳嗽无力","气短声低","痰中偶夹有血","血色淡红","午后潮热","热势不高","面色白","颧红","少量盗汗或自汗","神疲倦怠","食欲不振"],"secondary_symptoms":[],"tongue_pulse":"舌质嫩红，边有齿印，苔薄，脉细弱而数","disease":"肺痨","source":"textbook","icd11_code":null}
{"code":"TB-038","name":"阴阳两虚证","is_category":false,"parent":null,"definition":"阴伤及阳，肺脾肾俱虚，肺虚气逆，精气虚竭。","location":["脾","肾","肺"],"nature":["气虚"],"cardinal_symptoms":["咳逆喘息少气","痰中或见夹血","血色暗淡","形体赢弱","劳热骨蒸","面浮肢肿","兼潮热","形寒","自汗","盗汗","声嘶失音","心慌","唇紫肢冷","五更泻","口舌生糜","男子滑精","阳痿","女子经少","经闭","舌光质红少津","或"],"secondary_symptoms":[],"tongue_pulse":"舌质淡体胖，边有齿痕，脉细而数，或虚大无力","disease":"肺痨","source":"textbook","icd11_code":null}
{"code":"TB-039","name":"外寒内饮证","is_category":false,"parent":null,"definition":"外感风寒，内停水饮。","location":[],"nature":["寒"],"cardinal_symptoms":["咳逆喘满不得卧","气短气急","咳痰白稀","呈泡沫状","胸部膨满","恶寒","周身酸楚","或口干不欲饮","面色青暗","舌体胖大","舌质暗淡"],"secondary_symptoms":[],"tongue_pulse":"舌苔白滑，脉浮紧","disease":"肺胀","source":"textbook","icd11_code":null}
{"code":"TB-040","name":"痰浊壅肺证","is_category":false,"parent":null,"definition":"痰浊内蕴，肺失宣降，肺虚脾弱。","location":["脾","肺"],"nature":["痰"],"cardinal_symptoms":["胸膺满闷","咳嗽痰多","色白黏腻或呈泡沫","短气喘息","稍劳即著","怕风汗多","脘痞纳少","倦怠乏力"],"secondary_symptoms":[],"tongue_pulse":"舌暗，苔薄腻或浊腻，脉滑","disease":"肺胀","source":"textbook","icd11_code":null}
{"code":"TB-041","name":"痰热郁肺证","is_category":false,"parent":null,"definition":"痰热壅肺，清肃失司，肺气上逆。","location":["肺"],"nature":["痰","热"],"cardinal_symptoms":["咳逆喘息气粗","痰黄或白","黏稠难咳","胸满烦躁","目胀晴突","或发热汗出","或微恶寒","黄便干","口渴欲饮"],"secondary_symptoms":[],"tongue_pulse":"舌质暗红，苔黄或黄腻，脉滑数","disease":"肺胀","source":"textbook","icd11_code":null}
{"code":"TB-042","name":"痰蒙神窍证","is_category":false,"parent":null,"definition":"痰蒙神窍，引动肝风。","location":["肝"],"nature":["痰"],"cardinal_symptoms":["咳逆喘促日重","咳痰不爽","表情淡漠","嗜睡","甚或意识蒙胧","妄","烦躁不安","人夜尤甚","昏迷","空理线","或肢体润动","抽搐"],"secondary_symptoms":[],"tongue_pulse":"舌质暗红或淡紫，或紫绛，苔白腻或黄腻，脉细滑数","disease":"肺胀","source":"textbook","icd11_code":null}
{"code":"TB-043","name":"痰阻肺证","is_category":false,"parent":null,"definition":"肺气壅滞，痰互结。","location":["肺"],"nature":["痰"],"cardinal_symptoms":["咳嗽痰多","色白或呈泡沫","喉间痰鸣","喘息不能平卧","胸部膨满","闷如塞","面色灰白而暗","唇甲发","舌质暗或紫"],"secondary_symptoms":[],"tongue_pulse":"舌下青筋增粗，苔腻或浊腻，脉弦滑","disease":"肺胀","source":"textbook","icd11_code":null}
{"code":"TB-044","name":"阳虚水泛证","is_category":false,"parent":null,"definition":"心肾阳虚，水饮内停。","location":["肾","心"],"nature":["阳虚"],"cardinal_symptoms":["面浮肢肿","甚或一身悉肿","脘痞腹胀","或腹满有水","尿少","心悸","喘咳不能平卧","咯痰清稀","怕冷","面唇青紫"],"secondary_symptoms":[],"tongue_pulse":"舌胖质暗，苔白滑，脉沉虚数或结代","disease":"肺胀","source":"textbook","icd11_code":null}
{"code":"TB-045","name":"肺肾气虚证","is_category":false,"parent":null,"definition":"肺肾两虚，气失摄纳。","location":["肾","肺"],"nature":[],"cardinal_symptoms":["呼吸浅短难续","咳声低怯","胸满短气","甚则张口抬肩","倚息不能平卧","咳嗽","痰如白沫","咳吐不利","心慌","形寒汗出","面色晦暗"],"secondary_symptoms":[],"tongue_pulse":"舌淡或暗紫，苔白润，脉沉细无力","disease":"肺胀","source":"textbook","icd11_code":null}
{"code":"TB-046","name":"虚热证","is_category":false,"parent":null,"definition":"肺阴亏耗，虚火内炽，灼津为痰。","location":["肺"],"nature":["痰"],"cardinal_symptoms":["咳吐浊唾","或咳痰带血","咳声不扬","甚则音嘎","气急喘促","口渴咽燥","可伴潮热盗汗","形体消瘦","皮毛干枯"],"secondary_symptoms":[],"tongue_pulse":"舌红而干，脉虚数","disease":"肺痿","source":"textbook","icd11_code":null}
