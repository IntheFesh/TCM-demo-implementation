{"code":"TB-168","name":"疫毒炽盛（急黄）证","is_category":false,"parent":null,"definition":"湿热疫毒炽盛，深人营血，内陷心肝。","location":["肝","心"],"nature":["湿","热"],"cardinal_symptoms":["发病急骤","黄疽迅速加深","其色如金","皮肤瘙痒","高热口渴","胁痛腹满","神昏语","烦躁抽搐","或见血","便血","或肌肤瘀斑"],"secondary_symptoms":[],"tongue_pulse":"舌质红绛，苔黄而燥，脉弦滑或数","disease":"黄疽","source":"textbook","icd11_code":null}
{"code":"TB-169","name":"疫毒炽盛（急黄）证","is_category":false,"parent":null,"definition":"中阳不振，寒湿滞留，肝胆失于疏泄。","location":["肝","胆"],"nature":["湿","寒"],"cardinal_symptoms":["身目俱黄","黄色晦暗","或如烟熏","脘腹痞胀","纳谷减少","大便不实","神疲畏寒","口淡不渴"],"secondary_symptoms":[],"tongue_pulse":"舌淡苔腻，脉濡缓或沉迟","disease":"黄疽","source":"textbook","icd11_code":null}
