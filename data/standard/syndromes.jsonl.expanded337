{"code":"TB-306","name":"阳明热盛证","is_category":false,"parent":null,"definition":"阳明胃热亢盛，腑气不通，热盛伤津，筋脉失养。","location":["胃"],"nature":["热"],"cardinal_symptoms":["壮热汗出","项背强急","手足挛急","甚则角弓反张","腹满便结","口渴喜冷饮"],"secondary_symptoms":[],"tongue_pulse":"舌质 红，苔黄燥，脉弦数","disease":"痉证","source":"textbook","icd11_code":null}
{"code":"TB-307","name":"心营热盛证","is_category":false,"parent":null,"definition":"热人心营，扰动神明，灼伤阴津，筋脉失养。","location":["心"],"nature":["热"],"cardinal_symptoms":["高热烦躁","神昏语","项背强急","四肢抽搐","甚则角弓反张"],"secondary_symptoms":[],"tongue_pulse":"舌质红绛，苔黄少津，脉细数","disease":"痉证","source":"textbook","icd11_code":null}
{"code":"TB-308","name":"痰浊阻滞证","is_category":false,"parent":null,"definition":"痰浊中阻，上蒙清窍，经络阻塞，筋脉失养。","location":[],"nature":["痰"],"cardinal_symptoms":["头痛昏蒙","神志呆滞","项背强急","四肢抽搐","胸脘满闷","呕吐痰涎"],"secondary_symptoms":[],"tongue_pulse":"舌苔白腻， 永滑或弦滑","disease":"痉证","source":"textbook","icd11_code":null}
{"code":"TB-309","name":"肺热津伤证","is_category":false,"parent":null,"definition":"肺燥伤津，五脏失润，筋脉失养。","location":["肺"],"nature":[],"cardinal_symptoms":["发病急","病起发热","或发热后突然出现肢体软弱无力","可较快出现肌肉瘦削","皮肤干燥","心烦口渴","咳呛少痰","咽干不利","小便黄赤或热痛","大便干燥"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄，脉","disease":"痿证","source":"textbook","icd11_code":null}
{"code":"TB-310","name":"湿热浸淫证","is_category":false,"parent":null,"definition":"湿热浸渍，壅遏经脉，营卫受阻。","location":[],"nature":["湿","热"],"cardinal_symptoms":["起病较缓","逐渐出现肢体困重","痿软无力","尤以下肢或两足痿弱为甚","兼见微肿","手足麻木","足胫蒸热","或有全身发热","胸脘痞闷","小便赤涩热痛","舌质红"],"secondary_symptoms":[],"tongue_pulse":"舌苔黄腻，脉濡数或滑数","disease":"痿证","source":"textbook","icd11_code":null}
{"code":"TB-311","name":"脾胃虚弱证","is_category":false,"parent":null,"definition":"脾虚不健，生化乏源，气血亏虚，筋脉失养。","location":["脾"],"nature":[],"cardinal_symptoms":["起病缓慢","肢体软弱无力逐渐加重","神疲肢倦","肌肉萎缩","少气懒言","纳呆便","面色萎黄无华","面浮"],"secondary_symptoms":[],"tongue_pulse":"舌淡，苔薄白，脉细弱","disease":"痿证","source":"textbook","icd11_code":null}
{"code":"TB-312","name":"脾胃虚弱证","is_category":false,"parent":null,"definition":"肝肾亏虚，阴精不足，筋脉失养。","location":["肝","肾"],"nature":[],"cardinal_symptoms":["起病缓慢","渐见肢体痿软无力","尤以下肢明显","腰膝酸软","不能久立","甚至步履全废","腿胫大肉渐脱","或伴有眩晕耳鸣","舌咽干燥","遗精或遗尿","妇女月经不调"],"secondary_symptoms":[],"tongue_pulse":"舌红少苔，脉细数","disease":"痿证","source":"textbook","icd11_code":null}
{"code":"TB-313","name":"脉络阻证","is_category":false,"parent":null,"definition":"气虚血，阻滞经络，筋脉失养。","location":[],"nature":["气虚"],"cardinal_symptoms":["久病体虚","四肢痿弱","肌肉瘦削","手足麻木不仁","四肢青筋显露","肌肤甲错","舌 痿伸缩不利"],"secondary_symptoms":[],"tongue_pulse":"舌质暗淡或有点斑，脉细涩","disease":"痿证","source":"textbook","icd11_code":null}
{"code":"TB-314","name":"风阳内动证","is_category":false,"parent":null,"definition":"肝郁阳亢，化火生风，扰动筋脉。","location":["肝"],"nature":[],"cardinal_symptoms":["肢体颤动粗大","程度较重","不能自制","头晕耳鸣","面赤烦躁","易激动","心情紧张时颤动加重","伴有肢体麻木","口苦而干","语言迟缓不清","流涎","尿赤","大便干"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄，脉弦滑数","disease":"颤证","source":"textbook","icd11_code":null}
{"code":"TB-315","name":"痰热风动证","is_category":false,"parent":null,"definition":"痰热内蕴，热极生风，筋脉失约。","location":[],"nature":["痰","热"],"cardinal_symptoms":["头摇不止","肢麻震颤","重则手不能持物","头晕目眩","胸脘痞闷","口苦口黏","甚则口吐痰涎","舌体胖大","有齿痕","舌质红"],"secondary_symptoms":[],"tongue_pulse":"舌苔黄腻，脉弦滑数","disease":"颤证","source":"textbook","icd11_code":null}
{"code":"TB-316","name":"阳气虚衰证","is_category":false,"parent":null,"definition":"阳气虚衰，温煦失职，筋脉不用。","location":[],"nature":["气虚"],"cardinal_symptoms":["头摇肢颤","筋脉拘挛","畏寒肢冷","四肢麻木","心悸懒言","动则气短","自汗","小便 清长或自遗","大便","舌质淡"],"secondary_symptoms":[],"tongue_pulse":"舌苔薄白，脉沉迟无力","disease":"颤证","source":"textbook","icd11_code":null}
{"code":"TB-317","name":"寒湿腰痛证","is_category":false,"parent":null,"definition":"寒湿闭阻，滞碍气血，经脉不利。","location":[],"nature":["湿","寒"],"cardinal_symptoms":["腰部冷痛重着","转侧不利","静卧病痛不减","寒冷或阴雨天加重"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，苔白腻，脉沉而迟缓","disease":"腰痛","source":"textbook","icd11_code":null}
{"code":"TB-318","name":"湿热腰痛证","is_category":false,"parent":null,"definition":"湿热壅遏，经气不畅，筋脉不舒。","location":[],"nature":["湿","热"],"cardinal_symptoms":["腰部疼痛","重着而热","暑湿阴雨天气加重","活动后或可减轻","身体困重","小便短赤"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄腻，脉濡数或弦数","disease":"腰痛","source":"textbook","icd11_code":null}
{"code":"TB-319","name":"肾阴虚证","is_category":false,"parent":null,"definition":"肾阴不足，腰脊失于濡养。","location":["肾"],"nature":[],"cardinal_symptoms":["腰部隐隐作痛","酸软无力","缠绵不愈","心烦少寐","口燥咽干","面色潮红","手足心 热"],"secondary_symptoms":[],"tongue_pulse":"舌红少苔，脉弦细数","disease":"腰痛","source":"textbook","icd11_code":null}
{"code":"TB-320","name":"肾阳虚证","is_category":false,"parent":null,"definition":"肾阳不足，腰脊失于温煦。","location":["肾"],"nature":[],"cardinal_symptoms":["腰部隐隐作痛","酸软无力","缠绵不愈","局部发凉","喜温喜按","遇劳更甚","卧则减轻","常反复发作","面色白","肢冷畏寒"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，苔薄白，脉沉细无力","disease":"腰痛","source":"textbook","icd11_code":null}
