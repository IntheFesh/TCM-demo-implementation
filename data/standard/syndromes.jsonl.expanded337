{"code":"TB-090","name":"肝肾亏虚证","is_category":false,"parent":null,"definition":"肝肾亏虚，阴血不足，筋脉失养。","location":["肝","肾"],"nature":[],"cardinal_symptoms":["半身不遂","患肢僵硬拘挛变形","舌强不语","或偏瘫","肢体肌肉萎缩","舌质红","脉 细","或"],"secondary_symptoms":[],"tongue_pulse":"舌质淡红，脉沉细","disease":"中风","source":"textbook","icd11_code":null}
{"code":"TB-091","name":"髓海不足证","is_category":false,"parent":null,"definition":"肾精亏虚，髓海失养，神机失用。","location":["肾"],"nature":[],"cardinal_symptoms":["忘失前后","兴趣缺失","起居怠惰","或倦怠嗜卧","行走缓慢","动作笨拙","甚则振掉","腰胫酸软","齿枯发焦","脑转耳鸣","目无所见"],"secondary_symptoms":[],"tongue_pulse":"舌质瘦色淡，脉沉细","disease":"痴呆","source":"textbook","icd11_code":null}
{"code":"TB-092","name":"脾肾亏虚证","is_category":false,"parent":null,"definition":"脾肾两虚，髓海失养，神机失用。","location":["脾","肾"],"nature":[],"cardinal_symptoms":["迷惑善忘","兴趣缺失","反应迟钝","易惊善恐","食少纳呆","或咂逆不食","口涎外溢","四肢不温","小便混浊","夜尿频多","或二便失禁","舌质淡"],"secondary_symptoms":[],"tongue_pulse":"舌体胖大，有齿痕，苔白或腻，脉沉细弱，两尺尤甚","disease":"痴呆","source":"textbook","icd11_code":null}
{"code":"TB-093","name":"痰浊蒙窍证","is_category":false,"parent":null,"definition":"痰浊上蒙，清窍被阻，神机失用。","location":[],"nature":["痰"],"cardinal_symptoms":["多忘不慧","表情呆滞","迷路误事","不言不语","忽歌忽笑","洁秽不分","亲疏不辨","口吐痰涎","纳呆呕恶","体肥懒动"],"secondary_symptoms":[],"tongue_pulse":"舌苔黏腻浊，脉弦而滑","disease":"痴呆","source":"textbook","icd11_code":null}
{"code":"TB-094","name":"心肝火旺证","is_category":false,"parent":null,"definition":"心肝火旺，上扰清窍，神机失用。","location":["肝","心"],"nature":[],"cardinal_symptoms":["急躁易怒","烦躁不安","妄闻妄见","妄思妄行","或举止异常","噩梦纷","或梦幻游离","或梦寐喊叫","头晕目眩","头痛","耳鸣如潮","口臭口疮","尿赤便干"],"secondary_symptoms":[],"tongue_pulse":"舌质红或绛，苔黄或黄腻，脉弦滑或弦数","disease":"痴呆","source":"textbook","icd11_code":null}
{"code":"TB-095","name":"热毒内盛证","is_category":false,"parent":null,"definition":"火热久蕴，内生浊毒，神机失用。","location":[],"nature":["热"],"cardinal_symptoms":["无欲无语","迷蒙昏睡","不识人物","神呆遗尿","或二便失禁","身体蜷缩不动","或躁扰不宁","甚则狂越","或语妄言","肢体僵硬","或颤动","或痫痉"],"secondary_symptoms":[],"tongue_pulse":"舌质红绛，苔少，或苔黏腻浊，或腐秽厚积，脉数","disease":"痴呆","source":"textbook","icd11_code":null}
{"code":"TB-096","name":"痰气郁结证","is_category":false,"parent":null,"definition":"肝气郁结，脾失健运，气郁痰结，蒙蔽神窍。","location":["脾","肝"],"nature":["痰"],"cardinal_symptoms":["精神抑郁","表情淡漠","沉默痴呆","时时太息","言语无序","或喃喃自语","多疑多虑","喜怒无常","秽洁不分","不思饮食"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔腻而白，脉弦滑","disease":"癫狂","source":"textbook","icd11_code":null}
{"code":"TB-097","name":"心脾两虚证","is_category":false,"parent":null,"definition":"脾失健运，生化乏源，心神失养。","location":["脾","心"],"nature":[],"cardinal_symptoms":["神思恍惚","魂梦颠倒","心悸易惊","善悲欲哭","肢体困乏","言语无序","面色苍白"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，苔薄白，脉细弱无力","disease":"癫狂","source":"textbook","icd11_code":null}
{"code":"TB-098","name":"心脾两虚证","is_category":false,"parent":null,"definition":"五志化火，炼液为痰，上扰清窍，扰乱心神。","location":["心"],"nature":["痰"],"cardinal_symptoms":["性情急躁","头痛失眠","两目怒视","面红目赤","突然狂暴无知","逾垣上屋","骂叫号","不避亲疏","或毁物伤人","或哭笑无常","登高而歌","弃衣而走","不食不眠"],"secondary_symptoms":[],"tongue_pulse":"舌质红绛，苔多黄腻，脉弦滑数","disease":"癫狂","source":"textbook","icd11_code":null}
{"code":"TB-099","name":"痰热瘀结证","is_category":false,"parent":null,"definition":"气郁痰结，血气凝滞，瘀热互结，神窍被扰。","location":[],"nature":["痰","热"],"cardinal_symptoms":["癫狂日久不愈","面色晦滞而秽","情绪躁扰不安","多言无序","恼怒不休","甚至登高而歌","弃衣而走","妄见妄闻","妄思离奇","头痛","心悸而烦"],"secondary_symptoms":[],"tongue_pulse":"舌质紫暗或有斑，苔少或薄黄而干，脉弦细或细涩","disease":"癫狂","source":"textbook","icd11_code":null}
{"code":"TB-100","name":"火盛伤阴证","is_category":false,"parent":null,"definition":"久病阴伤，气阴两伤，虚火旺盛，扰乱心神。","location":["心"],"nature":[],"cardinal_symptoms":["狂证日久","病势较缓","时作时止","精神疲惫","情绪焦虑","烦躁不眠","形瘦面红","五心烦热"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔少或无，脉细数","disease":"癫狂","source":"textbook","icd11_code":null}
{"code":"TB-101","name":"阳痫证","is_category":false,"parent":null,"definition":"肝风夹痰，蒙蔽清窍，气血逆乱。","location":["肝"],"nature":["痰"],"cardinal_symptoms":["突然昏仆","不省人事","面色潮红","紫红","继之转为青紫或苍白","口唇青紫","牙关紧闭","两目上视","项背强直","四肢抽搐","口吐涎沫","或喉中痰鸣","或发怪叫","甚则二便自遗","移时苏醒。病发前多有眩晕","头痛而胀","胸闷乏力","喜欠伸等先兆症状","平素多有情绪急躁","心烦失眠","口苦咽干","便秘尿黄。"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔白腻或黄腻，脉弦数或弦滑","disease":"痫证","source":"textbook","icd11_code":null}
{"code":"TB-102","name":"阳痫证","is_category":false,"parent":null,"definition":"寒痰湿浊，上蒙清窍，元神失控。","location":[],"nature":["痰","湿","寒"],"cardinal_symptoms":["突然昏仆","不省人事","面色嗨暗青灰而黄","手足清冷","双眼半开半合","肢体拘急","或抽搐时作","口吐涎沫","一般口不啼叫","或声音微小","醒后周身疲乏","或如常人","或仅表现为一过性呆木无知","不闻不见","不动不语","数秒至数分钟即可恢复","恢复后对上述症状全然不知","多则一日数次或十数次发作。平素神疲乏力","恶心泛呕","胸闷咳痰","纳差便唐。"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，苔白腻，脉多沉细或沉迟","disease":"痫证","source":"textbook","icd11_code":null}
{"code":"TB-103","name":"肝火痰热证","is_category":false,"parent":null,"definition":"肝郁化火，痰火内盛，上扰元神。","location":["肝"],"nature":["痰"],"cardinal_symptoms":["平时急躁易怒","面红目赤","心烦失眠","咳痰不爽","口苦咽干","便秘渡黄","发作时昏仆抽搐","吐涎","或有吼叫。"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄腻，脉弦滑而数","disease":"痫证","source":"textbook","icd11_code":null}
{"code":"TB-104","name":"脾虚痰盛证","is_category":false,"parent":null,"definition":"脾虚不运，痰湿内盛。","location":["脾"],"nature":["痰","湿"],"cardinal_symptoms":["平素神疲乏力","少气懒言","胸脘痞闷","纳差便","发作时面色嗨滞或白","四肢 不温","蜷卧拘急","呕吐涎沫","叫声低怯。"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，苔白腻，脉濡滑或弦细滑","disease":"痫证","source":"textbook","icd11_code":null}
{"code":"TB-105","name":"肝肾阴虚证","is_category":false,"parent":null,"definition":"痫证日久，肝肾阴虚，髓海不足，脑失所养。","location":["肝","肾"],"nature":["阴虚"],"cardinal_symptoms":["痫证频发","神思恍惚","面色晦暗","头晕目眩","伴两目干涩","耳轮焦枯不泽","健忘失眠","腰膝酸软","大便干燥"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔薄白或薄黄少津，脉沉细数","disease":"痫证","source":"textbook","icd11_code":null}
{"code":"TB-106","name":"寒邪客胃证","is_category":false,"parent":null,"definition":"寒邪客胃，暴遏阳气，气机郁滞。","location":["胃"],"nature":["寒"],"cardinal_symptoms":["胃痛暴作","拘急冷痛","恶寒喜暖","得温痛减","遇寒加重","口不渴","喜热饮","有感寒或食冷病史"],"secondary_symptoms":[],"tongue_pulse":"舌苔薄白，脉弦紧","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-107","name":"饮食伤胃证","is_category":false,"parent":null,"definition":"饮食积滞，壅阻胃气。","location":["胃"],"nature":["食积"],"cardinal_symptoms":["胃脘疼痛","胀满拒按","腐吞酸","或呕吐不消化食物","其味腐臭","吐后痛减","不思饮食","大便不爽","得矢气及便后稍舒","有暴饮暴食病史"],"secondary_symptoms":[],"tongue_pulse":"舌苔厚腻，脉滑","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-108","name":"肝气犯胃证","is_category":false,"parent":null,"definition":"肝气郁滞，横逆犯胃，胃气阻滞。","location":["胃","肝"],"nature":[],"cardinal_symptoms":["胃脘胀痛","或攻撑窜动","牵引背胁","情绪波动诱发或导致疼痛加重","气","矢气则痛舒","胸闷叹息","大便不畅"],"secondary_symptoms":[],"tongue_pulse":"舌苔薄白，脉弦","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-109","name":"肝胃郁热证","is_category":false,"parent":null,"definition":"肝郁化火，郁热伤胃。","location":["胃","肝"],"nature":["热"],"cardinal_symptoms":["胃脘灼痛","烦躁易怒","烦热不安","胁胀不舒","泛酸嘈杂","口干口苦"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄，脉弦或数","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-110","name":"湿热中阻证","is_category":false,"parent":null,"definition":"湿热蕴结，胃气壅滞。","location":["胃"],"nature":["湿","热"],"cardinal_symptoms":["胃脘灼痛","吐酸嘈杂","脘痞腹胀","纳呆恶心","口渴不欲饮水","小便黄","大便不畅"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄腻，脉滑数","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-111","name":"血停滞证","is_category":false,"parent":null,"definition":"停胃络，脉络缠滞。","location":["胃"],"nature":[],"cardinal_symptoms":["胃脘刺痛","痛有定处","按之痛甚","疼痛延久屡发","食后加剧","入夜尤甚","甚或出现黑便或呕血"],"secondary_symptoms":[],"tongue_pulse":"舌质紫暗或有瘀斑，脉涩","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-112","name":"脾胃虚寒证","is_category":false,"parent":null,"definition":"中焦虚寒，胃失温养。","location":["胃"],"nature":["寒"],"cardinal_symptoms":["胃脘隐痛","绵绵不休","空腹痛甚","得食则缓","喜温喜按","劳累或受凉后发作或加重","泛吐清水","食少纳呆","大便薄","神疲倦怠","四肢不温"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，苔白，脉虚缓无力","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-113","name":"胃阴不足证","is_category":false,"parent":null,"definition":"胃阴不足，润降失司。","location":["胃"],"nature":[],"cardinal_symptoms":["胃脘隐隐灼痛","有时嘈杂似饥","或饥不欲食","口干咽燥","大便干结"],"secondary_symptoms":[],"tongue_pulse":"舌质红少津，或光剥无苔，脉弦细无力","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-114","name":"热证","is_category":false,"parent":null,"definition":"肝郁化火，横逆犯胃。","location":["胃","肝"],"nature":[],"cardinal_symptoms":["吞酸时作","暖腐气秽","胃脘闷胀","两胁胀满","时有呛咳","心烦易怒","口干口苦","咽干口渴"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄，脉弦数","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-115","name":"热证","is_category":false,"parent":null,"definition":"脾胃虚寒，胃失和降。","location":["脾","胃"],"nature":["寒"],"cardinal_symptoms":["吐酸时作","暖气酸腐","胸脘胀闷","喜唾涎沫","饮食喜热","四肢不温","大便泄"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，苔白，脉沉迟","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-116","name":"热证","is_category":false,"parent":null,"definition":"痰热阻胃，气机壅滞。","location":["胃"],"nature":["痰","热"],"cardinal_symptoms":["嘈杂而兼恶心吞酸","口渴喜冷","口臭心烦","脘闷痰多","多食易饥","或似饥非饥"],"secondary_symptoms":[],"tongue_pulse":"舌质红，苔黄干，脉滑数","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-117","name":"胃虚证","is_category":false,"parent":null,"definition":"脾胃气虚，气机不畅。","location":["脾","胃"],"nature":["气虚"],"cardinal_symptoms":["嘈杂时作时止","口淡无味","食后脘胀","体倦乏力","不思饮食"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，脉虚","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-118","name":"血虚证","is_category":false,"parent":null,"definition":"气血两虚，胃失所养。治法：益气养血，健脾和胃。代表方：归脾汤。常用药：黄芪、党参补气健脾；当归、龙眼肉养血和营；木香健脾理气；茯神、远志、枣仁养心安神；生姜、大枣、甘草和胃健脾，以资化源。","location":["脾","胃","心"],"nature":[],"cardinal_symptoms":["嘈杂时作","面白唇淡","头晕心悸","失眠多梦"],"secondary_symptoms":[],"tongue_pulse":"舌质淡，脉细弱","disease":"胃痛","source":"textbook","icd11_code":null}
{"code":"TB-119","name":"血虚证","is_category":false,"parent":null,"definition":"饮食停滞，胃腑失和，气机壅塞。","location":["胃"],"nature":[],"cardinal_symptoms":["脘腹满闷而胀","进食尤甚","暖腐吞酸","厌食呕吐","或大便不调","矢气频作","味臭 如败卵"],"secondary_symptoms":[],"tongue_pulse":"舌苔厚腻，脉滑","disease":"胃痛","source":"textbook","icd11_code":null}
